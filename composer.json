{
    "name": "youvision/think-carbon",
    "description": "基于 nesbot/carbon 的 ThinkPHP 8 日期时间扩展，提供门面、助手函数、容器绑定与本地化、时区适配。",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "thinkphp",
        "thinkphp8",
        "carbon",
        "datetime",
        "date",
        "time",
        "时间",
        "日期"
    ],
    "authors": [
        {
            "name": "youvision"
        }
    ],
    "require": {
        "php": ">=8.0",
        "topthink/framework": "^8.0",
        "nesbot/carbon": "^2.72 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6 || ^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Youvision\\ThinkCarbon\\": "src/"
        },
        "files": [
            "src/helper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Youvision\\ThinkCarbon\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "extra": {
        "think": {
            "services": [
                "Youvision\\ThinkCarbon\\Service"
            ],
            "config": {
                "carbon": "config/carbon.php"
            }
        }
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}